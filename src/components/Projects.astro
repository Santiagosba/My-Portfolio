---
import ReactIcon from "./icons/ReactIcon.astro";
import HtmlIcon from "./icons/HTMLIcon.astro";
import CSSIcon from "./icons/CSSIcon.astro";
import JavascriptIcon from "./icons/JavascriptIcon.astro";
import ViteIcon from "./icons/ViteIcon.astro";
import TailwindIcon from "./icons/TAILWINDCSSicon.astro";
import TypeScriptIcon from "./icons/TypescriptIcon.astro";
import ThreeJSIcon from "./icons/ThreeJSIcon.astro";
import NodeIcon from "./icons/NodeIcon.astro";
import PrismaIcon from "./icons/PrismaIcon.astro";
import PostgreSQLIcon from "./icons/PostgreSQLIcon.astro";
---

<!-- Featured -->
<article class="featured lg-card max-w-6xl mx-auto">
  <a href="/coachos" class="featured-media" aria-label="Read the CoachOS case study">
    <img src="/projects/coachos/dashboard.webp" alt="CoachOS trainer dashboard" class="featured-img" loading="lazy" />
  </a>
  <div class="featured-body">
    <span class="kicker">Featured · Full-stack product</span>
    <h3 class="project-title !mt-2 !text-2xl sm:!text-3xl">CoachOS</h3>
    <p class="project-desc !text-base">A platform for personal trainers and their clients. Trainers run their whole business from one dashboard; clients follow their plan, log every set and watch their progress.</p>
    <ul class="highlights sm:grid-cols-2 sm:gap-x-6">
      <li>Adherence engine that flags at-risk clients before they quit</li>
      <li>Strength rating per muscle group from e1RM and bodyweight</li>
      <li>Ranked progress leagues, check-ins, habits and progress photos</li>
      <li>Trainer, client and admin roles on iOS, Android and web</li>
    </ul>
    <div class="project-tags">
      <ReactIcon class="w-7 h-7" />
      <TypeScriptIcon class="w-7 h-7" />
      <NodeIcon class="w-7 h-7" />
      <PrismaIcon class="w-7 h-7" />
      <PostgreSQLIcon class="w-7 h-7" />
    </div>
    <div class="project-links">
      <a href="/coachos" class="btn">Read case study →</a>
      <a href="https://coachsystem.netlify.app" target="_blank" rel="noopener noreferrer" class="btn">Live app</a>
    </div>
  </div>
</article>

<!-- Playground -->
<div class="max-w-6xl mx-auto mt-16 sm:mt-24">
  <h3 class="text-2xl sm:text-3xl font-semibold text-white drop-shadow-[0_2px_6px_rgba(173,216,230,0.5)]">Playground</h3>
  <p class="mt-2 text-white/70">Smaller builds where I explore 3D, audio and UI ideas.</p>
</div>

<div class="playground grid gap-6 sm:grid-cols-3 max-w-6xl mx-auto mt-8">
  <article class="project-card lg-card">
    <img src="/projects/RubikCube.webp" alt="Rubik Cube 3D" class="project-img" loading="lazy" />
    <h3 class="project-title">Rubik Cube 3D</h3>
    <p class="project-desc">A 3D interactive Rubik’s Cube built with React and Three.js.</p>
    <div class="project-tags">
      <ReactIcon class="w-7 h-7" />
      <ViteIcon class="w-7 h-7" />
      <ThreeJSIcon class="w-7 h-7" />
    </div>
    <div class="project-links">
      <a href="https://github.com/Santiagosba/Rubik-Cube" target="_blank" rel="noopener noreferrer" class="btn">View Code</a>
      <a href="https://rubikcube3d.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn">View Project</a>
    </div>
  </article>

  <article class="project-card lg-card">
    <img src="/projects/bmth_media_player.webp" alt="Music Player" class="project-img" loading="lazy" />
    <h3 class="project-title">BMTH Music Player</h3>
    <p class="project-desc">A custom music player to listen to Bring Me The Horizon.</p>
    <div class="project-tags">
      <ReactIcon class="w-7 h-7" />
      <TypeScriptIcon class="w-7 h-7" />
      <ViteIcon class="w-7 h-7" />
      <TailwindIcon class="w-7 h-7" />
    </div>
    <div class="project-links">
      <a href="https://github.com/Santiagosba/Bmth-Media-Player" target="_blank" rel="noopener noreferrer" class="btn">View Code</a>
      <a href="https://bmthmediaplayer.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn">View Project</a>
    </div>
  </article>

  <article class="project-card lg-card">
    <img src="/projects/Digital World Clock.webp" alt="World Clock" class="project-img" loading="lazy" />
    <h3 class="project-title">World Clock</h3>
    <p class="project-desc">An interactive world clock with military aesthetic and timezones.</p>
    <div class="project-tags">
      <HtmlIcon class="w-7 h-7" />
      <CSSIcon class="w-7 h-7" />
      <JavascriptIcon class="w-7 h-7" />
    </div>
    <div class="project-links">
      <a href="https://github.com/Santiagosba/Digital-World-Clock" target="_blank" rel="noopener noreferrer" class="btn">View Code</a>
      <a href="https://militarclock.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn">View Project</a>
    </div>
  </article>
</div>

<style>
  .featured {
    @apply p-5 sm:p-7 grid gap-6 sm:gap-8;
  }
  .featured-media {
    @apply block rounded-2xl overflow-hidden;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .featured-img {
    @apply w-full h-full object-cover object-left-top;
    aspect-ratio: 16 / 10;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  .featured-media:hover .featured-img {
    transform: scale(1.03);
  }
  .kicker {
    @apply text-xs font-semibold uppercase tracking-[0.18em] text-orange-300;
  }
  .highlights {
    @apply mt-4 grid gap-2 text-sm text-white/80;
  }
  .highlights li {
    @apply relative pl-5;
  }
  .highlights li::before {
    content: "";
    @apply absolute left-0 top-[0.55em] w-1.5 h-1.5 rounded-full bg-orange-300;
    box-shadow: 0 0 8px rgba(253,186,116,0.8);
  }
  .project-card {
    @apply p-6;
  }
  .playground .project-card {
    @apply p-4 flex flex-col;
  }
  .playground .project-img {
    height: 140px;
  }
  .playground .project-title {
    @apply text-lg;
  }
  .playground .project-tags :global(svg) {
    @apply w-6 h-6;
  }
  .playground .project-links {
    @apply mt-auto pt-5 gap-2;
  }
  .playground .btn {
    @apply px-3 text-xs;
  }
  .project-img {
    @apply rounded-2xl w-full object-cover shadow-lg;
    height: 180px;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .project-title {
    @apply mt-4 text-xl font-bold text-white;
    text-shadow: 0 2px 8px rgba(173,216,230,0.4);
  }
  .project-desc {
    @apply mt-2 text-white/80 text-sm leading-relaxed;
  }
  .project-tags {
    @apply flex gap-3 mt-4;
  }
  .project-links {
    @apply flex flex-wrap gap-3 mt-5;
  }
  .btn {
    @apply px-4 py-1.5 rounded-full text-sm font-medium text-white/90;
    background-image:
      linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 45%, rgba(0,0,0,0.10) 100%),
      linear-gradient(108deg, transparent 0%, rgba(255,255,255,0.055) 45%, transparent 65%);
    backdrop-filter: blur(7px) saturate(150%) contrast(1.03) brightness(1.04);
    -webkit-backdrop-filter: blur(7px) saturate(150%) contrast(1.03) brightness(1.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-top-color: rgba(255,255,255,0.38);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.24),
      /* Chromatic aberration — red one side, cyan the other */
      -1px 0 0 rgba(255,40,90,0.15),
       1px 0 0 rgba(40,200,255,0.17),
      inset 2px 0 8px -2px rgba(255,40,90,0.44),
      inset -2px 0 8px -2px rgba(40,200,255,0.48),
      inset 0 -1px 0 rgba(0,0,0,0.48),
      0 8px 24px rgba(0,0,0,0.38),
      0 2px 6px rgba(0,0,0,0.22);
    transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.28s ease, border-color 0.28s ease;
  }
  .btn:hover {
    transform: translateY(-2px) scale(1.04);
    border-top-color: rgba(255,255,255,0.52);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.32),
      -1.5px 0 0 rgba(255,40,90,0.24),
       1.5px 0 0 rgba(40,200,255,0.28),
      inset 2px 0 10px -2px rgba(255,40,90,0.58),
      inset -2px 0 10px -2px rgba(40,200,255,0.62),
      inset 0 -1px 0 rgba(0,0,0,0.48),
      0 12px 36px rgba(0,0,0,0.46),
      0 0 20px rgba(110,70,220,0.20);
  }
</style>
